@host = http://localhost:10405

### 가상데이터 생성 Flow 생성
POST {{host}}/api/rule-engine/organizations/2/storages/1/sections/2/virtual-sensor
Content-Type: application/json

{
  "temperature": {
    "min": 10,
    "max": 30
  },
  "humidity": {
    "min": 30,
    "max": 70
  },
  "doorOpenProbability": 0.5,
  "measurementIntervalSeconds": 60,
  "deviceEui": "device-eui-virtual-1"
}